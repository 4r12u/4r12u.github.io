---
import ArchivePanel from "@components/features/archive/ArchivePanel.svelte";
import CategoryBar from "@components/features/posts/CategoryBar.astro";
import EmptyPosts from "@components/features/posts/EmptyPosts.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";

import { siteConfig } from "../config";

const sortedPostsList = await getSortedPostsList();

const showCategoryBar = siteConfig.postListLayout.categoryBar?.enable ?? false;

// 1. 修复类型兼容性：将 category 的 null 转换为 undefined
const posts = sortedPostsList.map((post) => ({
	id: post.id,
	url: post.url,
	data: {
		title: post.data.title,
		tags: post.data.tags,
		category: post.data.category === null ? undefined : post.data.category,
		published: post.data.published,
		_publishedDateOnly: post.data._publishedDateOnly,
		alias: post.data.alias,
		permalink: post.data.permalink,
	},
}));

// 2. 提取所有标签 (去重)
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

// 3. 提取所有分类 (去重且过滤掉 undefined)
const categories = [
	...new Set(
		posts
			.map((post) => post.data.category)
			.filter((c): c is string => typeof c === "string"),
	),
];
---

<MainGridLayout title="Archive" description="A timeline of write-ups, code, research papers, and study materials by Duc Nguyen.">
	<h1 class="text-3xl font-bold text-90 mb-4 px-2">Archive</h1>
	{posts.length === 0 && <EmptyPosts />}
	{posts.length > 0 && showCategoryBar && <CategoryBar />}
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<!-- 修复：补全缺失的 tags 和 categories 属性 -->
	{posts.length > 0 && <ArchivePanel
		sortedPosts={posts}
		tags={tags}
		categories={categories}
		client:only="svelte"
	/>}
</MainGridLayout>
